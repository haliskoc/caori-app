{
  "name": "calai",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@calai/web",
    "dev:mobile": "turbo run dev --filter=@calai/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "turbo run db:push --filter=@calai/web",
    "db:generate": "turbo run db:generate --filter=@calai/web"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.44.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@9.14.0",
  "engines": {
    "node": ">=18"
  }
}
